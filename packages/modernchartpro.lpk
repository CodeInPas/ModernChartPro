<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="modernchartpro"/>
    <Type Value="RunAndDesignTime"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\src\core;..\src\data;..\src\charts"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Files>
      <Item>
        <Filename Value="..\src\core\mc_types.pas"/>
        <UnitName Value="mc_types"/>
      </Item>
      <Item>
        <Filename Value="..\src\core\mc_utils.pas"/>
        <UnitName Value="mc_utils"/>
      </Item>
      <Item>
        <Filename Value="..\src\data\mc_dataset.pas"/>
        <UnitName Value="mc_dataset"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_basechart.pas"/>
        <UnitName Value="mc_basechart"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_barchart.pas"/>
        <UnitName Value="mc_barchart"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_horizontalbarchart.pas"/>
        <UnitName Value="mc_horizontalbarchart"/>
      </Item>
      <Item>
        <Filename Value="mc_register.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="mc_register"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_stackedbarchart.pas"/>
        <UnitName Value="mc_stackedbarchart"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_linechart.pas"/>
        <UnitName Value="mc_linechart"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_bubblechart.pas"/>
        <UnitName Value="mc_bubblechart"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_combochart.pas"/>
        <UnitName Value="mc_combochart"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_piechart.pas"/>
        <UnitName Value="mc_piechart"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_radarchart.pas"/>
        <UnitName Value="mc_radarchart"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_candlestickchart.pas"/>
        <UnitName Value="mc_candlestickchart"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_areachart.pas"/>
        <UnitName Value="mc_areachart"/>
      </Item>
      <Item>
        <Filename Value="..\src\charts\mc_scatterchart.pas"/>
        <UnitName Value="mc_scatterchart"/>
      </Item>
      <Item>
        <Filename Value="modernchartpro.res"/>
        <Type Value="Binary"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="BGRABitmapPack"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
